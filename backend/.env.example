# Runtime configuration shared by local Python runs and Docker Compose.
# Values supplied by the environment take precedence over this file.
DATABASE_URL=sqlite:///./data/sql_app.db
SECRET_KEY=change-this-before-production
FRONTEND_ORIGIN=http://localhost:5173

# Optional AI integration
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# Optional SMTP integration
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
